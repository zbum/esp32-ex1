# Copy to .env (gitignored). Makefile syntax: VAR := value
# Do not wrap values in quotes.

WIFI_SSID := YourSSID
WIFI_PASS := YourPassword

# Prometheus Pushgateway base. The firmware POSTs to
# $(PUSH_URL)/metrics/job/$(PUSH_JOB)/instance/$(PUSH_INSTANCE)
PUSH_URL := http://192.168.31.102:9091
PUSH_JOB := esp32-ex1
PUSH_INSTANCE := esp32
